        <!-- هر نصب رمز خودش را از `PLUGIN_DDL_PASSWORD` می‌گیرد. -->
        <env name="PLUGIN_DDL_PASSWORD" value="phpunit-ddl-secret-5c1e" force="true"/>
        <!-- E70: پایهٔ URL عمومی دیسک s3 (`filesystems.disks.s3.url`).
             ثابت و `force=true`: تست‌های غنی‌سازی رسانه (`PublicPageMediaUrlTest`،
             `SiteSettingsTest`، `LogoWidgetTest`) انتظارِ URL روی دیسک s3 را از
             همین پیکربندی می‌سازند؛ اگر به `.env` محیط گره بخورد (که `AWS_URL`
             ندارد)، همه بی‌صدا `null` می‌گیرند و ۸ تست قرمز می‌شود. مقدار همان
             `.env.example` است؛ هیچ درخواستی به آن زده نمی‌شود، فقط رشته‌سازی. -->
        <env name="AWS_URL" value="http://localhost:9100/cms" force="true"/>
        <env name="AWS_ENDPOINT" value="http://minio:9000" force="true"/>
        <env name="AWS_BUCKET" value="cms" force="true"/>
        <env name="AWS_USE_PATH_STYLE_ENDPOINT" value="true" force="true"/>
    </php>

    <!--
        نقش `pishdad_plugin_ddl` یک شیءِ **کلاستری** است: `CREATE ROLE`/
        `ALTER ROLE` در PostgreSQL روی کلِ سرور اثر دارد. یعنی نقش بین
        `cms` (واقعی) و `pishdad_test` (تست) مشترک است.

        پس `<env>` بالا با `force="true"` — که `EnsuresPluginDdlRole` در
        `setUpBeforeClass` روی نقش می‌نویسد — **رمزِ محیطِ توسعه را عوض
        می‌کرد**. نتیجه: بعد از هر `php artisan test`، پنل با «رمز پیکربندی
        به نقش وصل نمی‌شود» می‌افتاد، در حالی که همهٔ تست‌ها سبز بودند.

        این extension بعد از پایانِ سوئیت رمزِ واقعیِ `.env` را برمی‌گرداند.
        تنها جایی است که می‌دانیم هیچ تستی در حال اجرا نیست.
    -->
    <extensions>
        <bootstrap class="Tests\Support\RestoresPluginDdlRole"/>
    </extensions>
</phpunit>
