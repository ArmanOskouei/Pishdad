APP_NAME="پیشداد"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
# Next.js app (reset-password links point here — API has no Blade routes)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Postgres (compose service `db`; host-side port is 5433, see docker-compose.yml)
DB_CONNECTION=pgsql
# مقادیر پایگاه داده را خالی بگذارید: نصب‌کنندهٔ وب آن‌ها را پر می‌کند و در
# «گام ۲ — پایگاه داده» با پیش‌فرضِ Pishdad از شما می‌پرسد. اگر اینجا مقداری
# بنویسید، همان بر پیش‌فرض اولویت می‌گیرد و راهنمای گام ۲ هم آن را نشان می‌دهد.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Cache on DB (NOT redis: per threat model Redis is not a security boundary —
# never sessions / 2FA challenges / sensitive data there). Redis stays
# available for the future ISR cacheHandler / queues.
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- E2 — ایمیل (فقط پیکربندی؛ اعتبارنامهٔ واقعی در ریپو نیست و E2 هنوز pending است) ----
#
# ⚠️ بعد از هر تغییرِ این بخش، `php artisan pishdad:doctor` را اجرا کنید.
#    اگر درایورِ واقعی انتخاب شده باشد ولی کلیدها خالی باشند، `doctor` آن را
#    `MISSING` می‌گوید و exit code 1 می‌دهد — یعنی تنظیم ناقص بی‌صدا رد نمی‌شود.
#
# MAIL_MAILER=failover → اول smtp، اگر نشد log. برای توسعه `log` بگذارید.
MAIL_MAILER=failover
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# نکته: `failover` با کلیدِ خالی «کار می‌کند» ولی پیام‌ها فقط در لاگ می‌روند.
# `doctor` این حالت را `warn` می‌دهد؛ `smtp` تنها با کلیدِ خالی `MISSING` است.

# ---- E5 — پشتیبان‌گیری pg_dump (بدون DATABASE_URL، `backup:run` عمداً FAILURE می‌دهد) ----
# DATABASE_URL=postgres://cms:secret@db:5432/cms?sslmode=disable
BACKUP_KEEP=7
BACKUP_TIMEOUT=600
# BACKUP_PG_DUMP=pg_dump
# BACKUP_PATH=/var/backups/cms

# MinIO (compose service `minio`) via the S3 disk
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cms
AWS_ENDPOINT=http://minio:9000  # server-side only (containers); browsers use AWS_URL + proxied upload
AWS_URL=http://localhost:9100/cms
AWS_USE_PATH_STYLE_ENDPOINT=true

FILESYSTEM_DISK=local

# Revalidate webhook shared secret with Next.js (must match frontend env)
REVALIDATE_SECRET=change-me-local-dev-only
REVALIDATE_LEEWAY=300
REVALIDATE_URL=http://host.docker.internal:3100/api/revalidate

# Billing مرکزی (تسک‌های ۱.۲–۱.۴): درگاه Stub زرین‌پال (بدون شارژ واقعی) + راز HMAC وب‌هوک
# J10 — وب‌هوک پرداخت حذف شد (دورهٔ آزمایشی)؛ این URL دیگر routeای ندارد.
# PAYMENT_CALLBACK_URL=
PAYMENT_DRIVER=zarinpal-stub
ZARINPAL_MERCHANT_ID=stub-merchant
ZARINPAL_SANDBOX=true
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook

# ---- E3 — کانالِ پیامک ----
#
# درایورها: `null` (پیش‌فرض، هیچ پیامکی نمی‌رود) · `log` (فقط لاگ) · `panel` (واقعی)
#
# ⚠️ `SMS_DRIVER=panel` بدونِ کلیدهای زیر **fail-closed** است: درخواست با پیامِ
#    فارسی که نامِ دقیقِ کلیدِ جاافتاده را می‌گوید خطا می‌دهد. یعنی حالتِ
#    «فکر می‌کنم وصل است ولی نیست» ممکن نیست.
#
# تا وقتی درگاه ندارید همین `null` را نگه دارید: `sms/request` صادقانه
# `sms.not_configured` برمی‌گرداند و وانمود نمی‌کند کدی فرستاده شده.
SMS_DRIVER=null
# SMS_PANEL_URL=https://panel.your-provider.ir
# SMS_PANEL_API_KEY=
# SMS_PANEL_SENDER=10004346
# SMS_TIMEOUT=10
# SMS_DEFAULT_SENDER=

# ---- WF-M15 — کانالِ تلگرام (Bot API) ----
#
# ⭐ **fail-soft** است نه fail-closed: اگر `TELEGRAM_BOT_TOKEN` خالی باشد،
#    اعلان‌ها به تلگرام در صف گذاشته **نمی‌شوند** (نه اینکه شکست بخورند).
#    یعنی «ربات تنظیم نشده» یک وضعیتِ نصب است، نه خطای پیام. `pishdad:doctor`
#    هم همین را گزارش می‌دهد تا بدانید چرا پیامی نمی‌رسد.
#
# توکن را از @BotFather بگیرید. هر کاربر خودش chat_id را در پنل وارد می‌کند.
# (یا همان توکن را در پنل، صفحهٔ «ترجیحات اعلان»، بخشِ ربات تلگرام بگذارید.)
#
# ⭐ لازم نیست: نسخهٔ منتشرشده یک رباتِ آماده دارد (`@PishdadCMS_Bot`) و بدون
#   هیچ تنظیمی کار می‌کند؛ کاربر فقط chat_id می‌دهد و یک‌بار Start می‌زند.
#   این خط را فقط وقتی پر کنید که رباتِ خودتان را می‌خواهید. سه حالت دارد:
#     · خط اصلاً نباشد  ⇐ رباتِ پیش‌فرضِ عمومی (همین حالتِ پیش‌فرض)
#     · مقدار داشته باشد ⇐ رباتِ خودِ شما؛ برنده‌ی مطلق و پنل را کنار می‌زند
#     · خط باشد ولی خالی ⇐ خاموشیِ عمدی؛ کانال می‌رود روی حالتِ fail-soft و
#       پنل هم اجازهٔ فعال‌کردن نمی‌دهد (پیامِ روشن می‌دهد)
# توجه: تلگرام در ایران فیلتر است — اگر سرور در ایران باشد، ارسال کار نمی‌کند
# مگر آنکه سرور به اینترنتِ بدون فیلتر دسترسی داشته باشد.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_TIMEOUT=10


# ---- کلیدهایی که `pishdad:doctor` گزارش می‌کند ----
# PLUGIN_DDL_PASSWORD — رمزِ نقشِ محدودِ `pishdad_plugin_ddl` (بازنشانی: plugin-ddl:reset-password)
# PLUGIN_PUBLISHER_SECRET_KEY — کلیدِ مهرِ یکپارچگیِ بستهٔ افزونه/قالب (Ed25519).
#   خالی یعنی انتشارِ ناشر fail-closed می‌شود؛ `doctor` آن را `warn` می‌دهد.
# PLUGIN_PUBLISHER_SECRET_KEY=
# REVALIDATE_SECRET (بالا) — در production حتماً مقدارِ تصادفیِ بلند باشد؛
#   مقدارِ `change-me*` یعنی هرکس URL را حدس بزند می‌تواند کش سایت را باطال کند.

# Seeded superadmin (local dev only — override in real installs)
# SUPERADMIN_EMAIL=superadmin@local
# SUPERADMIN_PASSWORD=ChangeMe!123

# --- J2: منبع وضعیت اشتراک (دور یا محلی) --------------------------------------
# پیش‌فرضِ جاافتاده = **محلی**: داده در همین دیتابیس است و بستهٔ subscription آن را
# می‌خواند. این حالتِ عادیِ مشتری است و نیازی به این متغیرها ندارد.
#
# فقط وقتی پرش کن که مرکزی روی یک استقرارِ دیگر باشد (تسک J4). آن‌وقت این نصب
# جدول‌های اشتراک را نمی‌خواند و وضعیت را از راه HTTP می‌پرسد.
#
# ⚠️ پروتکل را کامل بنویس. آدرسِ بدونِ پروتکل باعث می‌شود هر درخواست شکست بخورد و
# resolver همیشه «نمی‌دانم» جواب بدهد — یعنی بازار بی‌سروصدا از کار می‌افتد.
# SUBSCRIPTION_REMOTE_URL=https://status.example.com
#
# مهلتِ HTTP به ثانیه. پیش‌فرض ۳ و **عمداً** کم: این مسیر در رندرِ صفحه صدا زده
# می‌شود و سایتِ مشتری نباید منتظرِ یک مرکزیِ پایین بماند.
# SUBSCRIPTION_REMOTE_TIMEOUT=3
#
# فقط اگر مرکزی توکن می‌خواهد. برای وضعیتِ عمومی لازم نیست.
# SUBSCRIPTION_REMOTE_TOKEN=
