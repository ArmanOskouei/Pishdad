# Pishdad web tier (API-only Laravel behind nginx, plus the Next.js frontend).
#
# CP-1/CP-6 — این فایل یک **template** است: ایمیج رسمی nginx هنگام استارتاپ
# `${WEB_PORT}` را جایگزین می‌کند (`/docker-entrypoint.d/20-envsubst-on-templates.sh`).
# لهذا در compose به `/etc/nginx/templates/` mount می‌شود، نه `conf.d/`.
#
# ⚠️ NGINX_ENVSUBST_FILTER در compose روی `^WEB_PORT$` قفل شده تا `$host`/`$uri`/
# `$args`/`$proxy_add_x_forwarded_for` — که همه در همین فایل هستند — هرگز
# جایگزین نشوند. بدون آن فیلتر، envsubst هر متغیرِ ناشناخته را خالی می‌گذارد
# و nginx با «invalid port» بالا نمی‌آید.
#
# قراردادِ پورت:
#   WEB_PORT         = پورتی که nginx داخل کانتینر گوش می‌دهد (پیش‌فرض ۸۰)
#   PISHDAD_WEB_PORT = پورتی که روی هاست منتشر می‌شود (پیش‌فرض ۸۰۸۰)
# روی VPS هیچ‌کدام ست نیست ⇒ رفتارِ بایت‌به‌بایتِ قبل. روی PaaS هر دو = PORT.

limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
limit_req_status 429;

log_format pishdad '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    'rt=$request_time urt=$upstream_response_time '
                    '"$http_referer" "$http_user_agent"';

server {
    listen ${WEB_PORT};
    server_name _;
    root /var/www/html/public;
    index index.php;

    server_tokens off;
    access_log /var/log/nginx/access.log pishdad;
    error_log /var/log/nginx/error.log warn;
    log_not_found off;

    client_max_body_size 20M;

    fastcgi_read_timeout 300s;
    fastcgi_send_timeout 300s;
    send_timeout 30s;
    keepalive_timeout 65s;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        application/json
        application/javascript
        application/x-javascript
        text/javascript
        text/css
        text/plain
        text/xml
        application/xml
        image/svg+xml
        application/rss+xml
        application/manifest+json;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    # HSTS فقط وقتی TLS در همین لبه تمام می‌شود معنا دارد؛ تا آن زمان کامنت.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ── CP-6: زنده‌بودنِ لبه، بدون PHP. probe پلتفرم این را می‌زند. ──────────
    # عمداً از لاراول رد نمی‌شود: در نصبِ تازه (که هنوز /install نشده) هم باید
    # ۲۰۰ بدهد و کانتینر در طوفانِ ری‌استارت نیفتد.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # نوبت‌کارِ بک‌اند: نصب‌کنندهٔ لاراول + سلامتِ لاراول.
    # ⚠️ `/setup` نصب‌کنندهٔ **فرانت** است و به بلوکِ پایین (Next) می‌رود.
    location ^~ /install {
        try_files $uri $uri/ /index.php?$query_string;
    }
    location = /up {
        try_files $uri /index.php?$query_string;
    }
    location ^~ /storage/ {
        alias /var/www/html/storage/app/public/;
        location ~ \.php$ { deny all; }
        add_header X-Content-Type-Options "nosniff";
        add_header Cache-Control "public, max-age=604800";
        expires 7d;
        access_log off;
    }

    # API لاراول — `/api/v1/` بلندتر از `/api/` است، پس همین برنده می‌شود.
    location ^~ /api/v1/ {
        limit_req zone=api burst=40 nodelay;
        try_files $uri /index.php?$query_string;
    }
    location ^~ /api/v1/auth/ {
        limit_req zone=auth burst=5 nodelay;
        try_files $uri /index.php?$query_string;
    }

    # PHP (بقیهٔ مسیرهایی که مستقیم به فایلِ php اشاره می‌کنند).
    location ~ \.php$ {
        fastcgi_pass app:9000;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        try_files $uri =404;
    }

    # دارایی‌های ایستا.
    location ~* \.(?:css|js|woff2?|ttf|avif|svg|png|jpe?g|webp|gif|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ── بقیهٔ /api/ و کل ترافیکِ صفحه → فرانت (CP-1) ───────────────────────
    # ⚠️ limit_req عمداً اینجا نیست: ۲۰r/s برای صفحاتِ عمومی یعنی ۴۲۹ تصادفی.
    # سقف فقط روی /api/v1/ می‌ماند.
    location ^~ /api/ {
        proxy_pass http://frontend:3000;
        include /etc/nginx/proxy_params_pishdad.conf;
    }

    location / {
        proxy_pass http://frontend:3000;
        include /etc/nginx/proxy_params_pishdad.conf;
    }

    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
    }
}
