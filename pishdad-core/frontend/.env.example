# ---- فرانت Next.js 15 (F1→F3) ----
# مرورگر → http://localhost:3000
# API لاراول (هاست ویندوز): http://localhost:8080/api
# ═══════════════════════════════════════════════════════════════════════════
# نصبِ آسان — راهِ توصیه‌شده
# ═══════════════════════════════════════════════════════════════════════════
# نیازی نیست این فایل را پر کنید. کانتینر را بالا بیاورید، به `/setup` بروید و
# فقط اطلاعاتِ بک‌اند را وارد کنید. نصب‌کننده در `config/runtime.json` می‌نویسد
# و **بدونِ بازسازی و بدونِ ری‌استارت** اعمال می‌شود.
#
# اگر ترجیح می‌دهید متغیرِ محیط بدهید، نام‌های زمانِ **اجرا** این‌ها هستند.
# بدونِ پیشوندِ NEXT_PUBLIC_ نوشته شده‌اند چون Next آن پیشوند را در زمانِ بیلد
# جای‌گذاری می‌کند و در زمانِ اجرا بی‌اثر می‌شود:
#
#   PISHDAD_PUBLIC_API_URL           نشانیِ عمومیِ API (مرورگر)
#   PISHDAD_PUBLIC_MEDIA_URL         پایهٔ دارایی‌های رسانه‌ای
#   PISHDAD_PUBLIC_VAPID_PUBLIC_KEY  کلیدِ عمومیِ Web Push
#   PISHDAD_SITE_ID                  شناسهٔ سایت (فقط چندسایتی)
#   PISHDAD_SITE_URL                 نشانیِ عمومیِ همین سایت (canonical/OG/sitemap)
#   PISHDAD_ASSET_URL                پایهٔ CDN برای /_next/static
#   PISHDAD_SITE_LOCALES             زبان‌های فعال، مثل fa,en
#   PISHDAD_SITE_PRIMARY_LOCALE      زبانِ پایه، مثل fa
#   PISHDAD_PANEL_ROOTS              ریشه‌های پنل (پیش‌فرض admin)
#   PISHDAD_BROWSER_PLUGIN_SLUGS     slugهای افزونهٔ مرورگر
#   PISHDAD_INTERNAL_API_URL         نشانیِ سرور-به-سرور (جانشینِ INTERNAL_API_URL)
#   PISHDAD_CONFIG_FILE              مسیرِ فایلِ تنظیمات (پیش‌فرض ./config/runtime.json)
#
# ترتیبِ اولویت: فایلِ نصب ← CMS_* ← NEXT_PUBLIC_* ← پیش‌فرض
#
# ⚠️ کلیدهای زیر فقط **fallbackِ زمانِ بیلد**اند. اگر ست نشوند هم همه‌چیز کار
# می‌کند (پیش‌فرضِ داخلی یا مقدارِ `/setup`).
# ═══════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# داخل کانتینر داکر، هاست از این آدرس در دسترس است:
INTERNAL_API_URL=http://host.docker.internal:8080/api

# ---- F3: سایت عمومی / ISR ----
# شناسه site این نصب برای رندر تعلیق خودکار (اختیاری؛ خالی = بدون بررسی تعلیق)
NEXT_PUBLIC_SITE_ID=
# نشانی عمومی سایت (fallback کانonical/OG/sitemap/llms وقتی site_url در تنظیمات خالی است)
NEXT_PUBLIC_SITE_URL=
# ---- ECO2: زبانِ سایتِ عمومی (باید با تنظیماتِ language_mode بک‌اند هم‌خوان باشد) ----
# فهرستِ زبان‌های فعال به ترتیب؛ خالی = تک‌زبانه با زبانِ اصلی.
NEXT_PUBLIC_SITE_LOCALES=
# زبانِ اصلیِ نصب که در ریشه سرو می‌شود؛ خالی = fa. زبانِ دوم زیر /{locale}.
NEXT_PUBLIC_SITE_PRIMARY_LOCALE=
# بیس فایل‌های عمومی MinIO (برای رندر <img> بلوک‌ها وقتی URL مستقیم دارند)
NEXT_PUBLIC_MEDIA_URL=http://localhost:9100/cms

# ---- F3: امضای revalidate (سرور-only — هرگز NEXT_PUBLIC_ نکنید!) ----
# سکرت مشترک با بک‌اند (همان مقداری که RevalidateSigner لاراول با آن امضا می‌کند)
REVALIDATE_SECRET=change-me-in-production

# ---- F3: cacheHandler روی Redis (اختیاری) ----
# خالی = fallback حافظه (dev/build). برای فعال‌سازی: `npm i redis` + باز کردن
# کامنت cacheHandler در next.config.ts
REDIS_URL=
# پیشوند کلیدها برای اشتراک Redis بین tenantها (per-tenant)
PISHDAD_CACHE_PREFIX=pishdad-cache:

# ---- K6.3: اعلانِ بلوکِ راندرنشده (سرور-only — هرگز NEXT_PUBLIC_ نکنید!) ----
# BlockRenderer برای هر `type` ناشناس (از جمله نوعی که افزونه در
# site.block_type اعلام کرده و بدنه‌اش هنوز به رندر وصل نیست) لاگ می‌کند.
# روشن‌کردنِ این پرچم یعنی علاوه بر لاگ، یک اعلانِ «رندر نشد» هم در خود صفحه
# دیده شود — برای staging/عیب‌یابی. مقدارِ غیر از 1 یعنی خاموش.
BLOCK_RENDER_DIAGNOSTICS=

# ---- L-B12: ریشه‌های خصوصی که build باید بداند (build-time) ----
#
# هسته دیگر نامِ هیچ افزونهٔ خاصی را نمی‌داند. هر پنل یا بستهٔ خصوصی خودش را
# اینجا اعلام می‌کند و build عمومی این دو را **خالی** می‌گذارد.
#
# NEXT_PUBLIC_PANEL_ROOTS — ریشه‌هایی که پروکسی پشت دروازهٔ کوکی می‌برد
# (پیش از L-B12 اینجا یک ریشهٔ خصوصی سخت‌کد بود). مثال: my-panel
NEXT_PUBLIC_PANEL_ROOTS=
# NEXT_PUBLIC_BROWSER_PLUGIN_SLUGS — slugهایی که پروکسی اجازهٔ صدا زدن
# /api/v1/p/{slug}/… از مرورگر را می‌دهد. خالی یعنی ریشهٔ افزونه از مرورگر
# بسته است. مثال: my-panel
NEXT_PUBLIC_BROWSER_PLUGIN_SLUGS=

# ---- WF-M13: دامنهٔ دارایی/CDN (اختیاری، build-time برای assetPrefix) ----
# همراستا با docs/CDN-ASSESSMENT.md: CDN فقط برای فایل‌های ایستای /_next/static
# (نه HTML). این مقدار در زمان ساخت خوانده می‌شود؛ دامنهٔ داراییِ پنل
# (asset_domain) جداگانه در «تنظیمات ← کارایی» ذخیره می‌شود.
NEXT_PUBLIC_ASSET_PREFIX=
# fallback محیطی برای دامنهٔ دارایی وقتی تنظیمات پنل خالی است.
NEXT_PUBLIC_ASSET_URL=