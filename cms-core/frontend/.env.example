# ---- فرانت Next.js 15 (F1→F3) ----
# مرورگر → http://localhost:3000
# API لاراول (هاست ویندوز): http://localhost:8080/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# داخل کانتینر داکر، هاست از این آدرس در دسترس است:
INTERNAL_API_URL=http://host.docker.internal:8080/api

# ---- F3: سایت عمومی / ISR ----
# شناسه site این نصب برای رندر تعلیق خودکار (اختیاری؛ خالی = بدون بررسی تعلیق)
NEXT_PUBLIC_SITE_ID=
# نشانی عمومی سایت (fallback کانonical/OG/sitemap/llms وقتی site_url در تنظیمات خالی است)
NEXT_PUBLIC_SITE_URL=
# بیس فایل‌های عمومی MinIO (برای رندر <img> بلوک‌ها وقتی URL مستقیم دارند)
NEXT_PUBLIC_MEDIA_URL=http://localhost:9100/cms

# ---- F3: امضای revalidate (سرور-only — هرگز NEXT_PUBLIC_ نکنید!) ----
# سکرت مشترک با بک‌اند (همان مقداری که RevalidateSigner لاراول با آن امضا می‌کند)
REVALIDATE_SECRET=change-me-in-production

# ---- F3: cacheHandler روی Redis (اختیاری) ----
# خالی = fallback حافظه (dev/build). برای فعال‌سازی: `npm i redis` + باز کردن
# کامنت cacheHandler در next.config.ts
REDIS_URL=
# پیشوند کلیدها برای اشتراک Redis بین tenantها (per-tenant)
CMS_CACHE_PREFIX=cms-cache:

# ---- K6.3: اعلانِ بلوکِ راندرنشده (سرور-only — هرگز NEXT_PUBLIC_ نکنید!) ----
# BlockRenderer برای هر `type` ناشناس (از جمله نوعی که افزونه در
# site.block_type اعلام کرده و بدنه‌اش هنوز به رندر وصل نیست) لاگ می‌کند.
# روشن‌کردنِ این پرچم یعنی علاوه بر لاگ، یک اعلانِ «رندر نشد» هم در خود صفحه
# دیده شود — برای staging/عیب‌یابی. مقدارِ غیر از 1 یعنی خاموش.
BLOCK_RENDER_DIAGNOSTICS=
