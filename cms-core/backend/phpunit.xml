<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- Feature tests run on the dedicated cms_test database (see docker/postgres/init/02-testdb.sql) -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="db" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="cms_test" force="true"/>
        <env name="DB_USERNAME" value="cms" force="true"/>
        <env name="DB_PASSWORD" value="cmssecret" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="REVALIDATE_SECRET" value="test-secret" force="true"/>
        <!-- Fixed testing-only key (random 32 bytes). Never use outside tests. -->
        <env name="APP_KEY" value="base64:PR8akB+5eVsv5VdD91nrhoHRsz+bo57kKRpCi3jAJmY=" force="true"/>
        <!-- K5.12: رمز نقش DDL افزونه (`pishdad_plugin_ddl`). -->
        <!-- ثابت و `force=true`: `EnsuresPluginDdlRole` این را از محیط می‌خواند -->
        <!-- چون در `setUpBeforeClass` هنوز اپی ساخته نشده و نمی‌توان از `config()` خواند. -->
        <!-- -->
        <!-- ⚠️ این رمز فقط آزمایشی است و به هیچ نصبی تعلق ندارد. نقشِ واقعی در -->
        <!-- هر نصب رمز خودش را از `PLUGIN_DDL_PASSWORD` می‌گیرد. -->
        <env name="PLUGIN_DDL_PASSWORD" value="phpunit-ddl-secret-5c1e" force="true"/>
    </php>
</phpunit>
