APP_NAME="CMS Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
# Next.js app (reset-password links point here — API has no Blade routes)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Postgres (compose service `db`; host-side port is 5433, see docker-compose.yml)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=cms
DB_USERNAME=cms
DB_PASSWORD=cmssecret

# Cache on DB (NOT redis: per threat model Redis is not a security boundary —
# never sessions / 2FA challenges / sensitive data there). Redis stays
# available for the future ISR cacheHandler / queues.
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (compose service `minio`) via the S3 disk
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cms
AWS_ENDPOINT=http://minio:9000  # server-side only (containers); browsers use AWS_URL + proxied upload
AWS_URL=http://localhost:9100/cms
AWS_USE_PATH_STYLE_ENDPOINT=true

FILESYSTEM_DISK=local

# Revalidate webhook shared secret with Next.js (must match frontend env)
REVALIDATE_SECRET=change-me-local-dev-only
REVALIDATE_LEEWAY=300
REVALIDATE_URL=http://host.docker.internal:3100/api/revalidate

# Billing مرکزی (تسک‌های ۱.۲–۱.۴): درگاه Stub زرین‌پال (بدون شارژ واقعی) + راز HMAC وب‌هوک
PAYMENT_DRIVER=zarinpal-stub
ZARINPAL_MERCHANT_ID=stub-merchant
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL=http://localhost:8080/api/webhooks/payment
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook

# چابکان مرکزی (تسک ۳.۳): درایور stub از کانفیگ می‌خواند — بدون تماس/شارژ واقعی.
# اتصال واقعی (مرحله ۵): CHABOKAN_DRIVER=api + CHABOKAN_API_TOKEN.
CHABOKAN_DRIVER=stub
CHABOKAN_WALLET_BALANCE=2500000
CHABOKAN_CURRENCY=IRT
CHABOKAN_LOW_BALANCE_THRESHOLD=500000
# CHABOKAN_API_BASE=https://api.chabakan.example/v1
# CHABOKAN_API_TOKEN=change-me

# Seeded superadmin (local dev only — override in real installs)
# SUPERADMIN_EMAIL=superadmin@local
# SUPERADMIN_PASSWORD=ChangeMe!123
