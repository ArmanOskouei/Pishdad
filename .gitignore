# فایل‌های حجیم/باینری — هرگز در git
docs/**/*.pdf
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.webp

# خروجی graphify (بسیار حجیم — ایندکس میلیون‌ها توکن)
graphify-out/
docs/**/graphify-out/

# فایل‌های موقت و ابزار
node_modules/
vendor/
dist/
build/
*.log
*.tmp
.env
.env.local

# کش/استور وابستگی‌ها که به داخل پروژه منتقل شده‌اند (۲۴۱MB npm cache، storeها)
.local/

# پیکربندی ماشین‌محور npm (مسیر مطلق کش) — قالب قابل‌اشتراک در .npmrc.example
.npmrc
**/.npmrc

# پیکربندی تست موقت ایجنت‌های موازی؛ هر کدام دیتابیس محلی خودشان را دارند.
cms-core/backend/phpunit.agent*.xml

# سیستم
.DS_Store
Thumbs.db

# کش افزایشیِ TypeScript — فایل ساخت، نه منبع. تغييرش يعني تغيير کد نيست.
*.tsbuildinfo

# ── کدِ خصوصی ──
#
# هیچ لایهٔ اختصاصی یا پولی در این مخزن نیست: نه پنل مرکزی، نه لایهٔ
# اشتراک و صورت‌حساب. قواعدِ نادیده‌گرفتنِ قدیمی حذف شدند چون مسیرهایشان
# دیگر وجود ندارند و بازگرداندنشان یعنی بازگرداندنِ همان نشتی.
# ── artifact های محلی (S1.8) ───────────────────────────────────────────────
# این‌ها خروجی یا وضعیتِ ماشینِ توسعه‌اند، نه محصول. اگر track شوند، بستهٔ خام
# آن‌ها را با خود می‌برد و نصب‌کننده چیزی می‌گیرد که به او مربوط نیست.
dist-pishdad/
dist-pishdad-backend/
dist-pishdad-frontend/
dist-public/
.opencode/
cms-core/frontend/.local-serve.err
cms-core/frontend/.local-serve.out
cms-core/backend/storage/install/
dist-offline/
dist-offline-backend/
dist-offline-frontend/

# E43 — پیکربندیِ نصبِ فرانت. نصب‌کنندهٔ وب این را می‌نویسد و رازِ revalidate
# داخلش است، پس هرگز نباید commit شود.
cms-core/frontend/config/runtime.json
cms-core/frontend/.setup-probe/
