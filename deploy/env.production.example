# E10 — قالبِ محیط تولید (کپی به `.env` روی سرور و پر کردن مقادیر).
# همهٔ مقدارهای خالی **الزامی**اند و باید پیش از استقرار پر شوند.
# مرجع گام‌ها: docs/DEPLOY-CHECKLIST.md

APP_NAME="Pishdad Core"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show
APP_URL=https://cms.example.com
APP_TIMEZONE=UTC
APP_LOCALE=fa

# ── پایگاه داده (سرویس compose به نام `db`) ──
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=cms
DB_USERNAME=cms
DB_PASSWORD=                  # ← رمز قوی

# ── Redis: کش/نشست/صف (در تولید یک مرز امنیتی نیست ⇒ دادهٔ حساس اینجا نه) ──
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ── رسانه: در تولید یا S3 مدیریت‌شده یا MinIO خصوصی. هرگز عمومی/بدون TLS. ──
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=                 # مثل https://s3.example.com
AWS_URL=                      # دامنهٔ عمومیِ فایل‌ها (TLS)
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── کش ISR فرانت (F5.1) — اگر `REDIS_URL` ست شود، cacheHandler فعال می‌شود ──
REDIS_URL=redis://redis:6379

# ── باطل‌سازی کش (HMAC با فرانت؛ باید با frant هم‌ارز باشد) ──
REVALIDATE_SECRET=            # openssl rand -hex 24
REVALIDATE_LEEWAY=300
REVALIDATE_URL=https://cms.example.com/api/revalidate

# ── SMTP واقعی (E2) ──
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=           # گیرندهٔ ایمیل فرم تماس (E6)

# ── نقش DDL افزونه (K5.7) — پیش از migrate اجرا و نتیجه‌اش ثبت می‌شود ──
PLUGIN_DDL_PASSWORD=          # رمز قوی

# ── سوپرادمین اولیه (PishdadInstall) ──
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
